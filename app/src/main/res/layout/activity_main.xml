<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true">

    <!-- СТЕКЛЯННЫЙ БЛОК СО СПИСКОМ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="0dp">

        <!-- ТАБЫ -->
        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/glass_background"
            android:padding="4dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Все"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/tab_selected" />

            <TextView
                android:id="@+id/tabWedding"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Свадебные"
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/tab_unselected" />

        </LinearLayout>

        <!-- СПИСОК ПЕСЕН -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/glass_background"
            android:padding="8dp"
            android:orientation="vertical"
            android:clipToOutline="true">

            <ListView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#00000000"
                android:divider="#22FFFFFF"
                android:dividerHeight="1dp"
                android:listSelector="@android:color/transparent"
                android:cacheColorHint="@android:color/transparent" />

        </LinearLayout>

    </LinearLayout>

    <!-- НИЖНЯЯ ПАНЕЛЬ С МИКРОФОНОМ (СКРЫТА ПО УМОЛЧАНИЮ) -->
    <LinearLayout
        android:id="@+id/micPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bottom_sheet_glass"
        android:elevation="8dp"
        android:visibility="invisible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/micButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF"
            android:background="@drawable/mic_background"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/micStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Нажми и скажи"
            android:textColor="#88FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:alpha="0.8" />

    </LinearLayout>

</FrameLayout>